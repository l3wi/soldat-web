  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "Preserve", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true, "noUncheckedIndexedAccess": true,
    "types": ["bun"], "skipLibCheck": true
